From: harunkkhan <harunkkhan1@gmail.com>
Subject: [PATCH] Cancel a passkey request that has no dialog to show

Chrome shows its passkey (WebAuthn) dialog as a web-modal dialog, whose
host comes from the tab's dialog manager delegate. EngineCore's tabs have no
such delegate, so showing the dialog dereferenced null and the browser
crashed on any sign-in that offered a passkey. The dialog is not created
without a host, and a request that reaches a dialog step without one is
cancelled, so the page gets NotAllowedError and falls back to its other
sign-in methods.
---
diff --git a/chrome/browser/ui/views/webauthn/authenticator_request_dialog_view_controller_views.cc b/chrome/browser/ui/views/webauthn/authenticator_request_dialog_view_controller_views.cc
--- a/chrome/browser/ui/views/webauthn/authenticator_request_dialog_view_controller_views.cc
+++ b/chrome/browser/ui/views/webauthn/authenticator_request_dialog_view_controller_views.cc
@@ -34,7 +34,9 @@
   // should audit this.
   auto* manager = web_modal::WebContentsModalDialogManager::FromWebContents(
       constrained_window::GetTopLevelWebContents(web_contents));
-  if (!manager) {
+  // EngineCore's tabs have a manager but no delegate to host a web-modal
+  // dialog in, so there is nowhere to show the dialog either.
+  if (!manager || !manager->delegate()) {
     return nullptr;
   }
 
diff --git a/chrome/browser/webauthn/authenticator_request_dialog_model.cc b/chrome/browser/webauthn/authenticator_request_dialog_model.cc
--- a/chrome/browser/webauthn/authenticator_request_dialog_model.cc
+++ b/chrome/browser/webauthn/authenticator_request_dialog_model.cc
@@ -11,10 +11,12 @@
 #include <utility>
 
 #include "base/containers/fixed_flat_map.h"
+#include "base/functional/bind.h"
 #include "base/functional/callback.h"
 #include "base/observer_list.h"
 #include "base/strings/string_number_conversions.h"
 #include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
 #include "chrome/browser/profiles/profile.h"
 #include "chrome/browser/signin/identity_manager_factory.h"
 #include "chrome/browser/ui/webauthn/authenticator_request_dialog_view_controller.h"
@@ -172,6 +174,17 @@
   } else if (previous_ui_type != StepUIType::DIALOG && web_contents) {
     view_controller_ =
         AuthenticatorRequestDialogViewController::Create(web_contents, this);
+    // With no dialog to show, the request would wait for input it can never
+    // get, so it is cancelled and the page falls back (EngineCore's tabs have
+    // no dialog host). Posted, as cancelling ends the request and its model
+    // from inside this transition.
+    if (!view_controller_) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              &AuthenticatorRequestDialogModel::CancelAuthenticatorRequest,
+              base::RetainedRef(this)));
+    }
   }
 
   for (auto& observer : observers) {

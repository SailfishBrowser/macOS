From: harunkkhan <harunkkhan1@gmail.com>
Subject: [PATCH 2/2] Link engine_core into the EngineCore framework

Adds the Objective-C bridge to the framework binary and publishes its
Headers and Modules directories so Swift can import EngineCore.
---
diff --git a/chrome/BUILD.gn b/chrome/BUILD.gn
--- a/chrome/BUILD.gn
+++ b/chrome/BUILD.gn
@@ -1340,6 +1340,7 @@
       "//components/policy:generated",
       "//components/webapps/isolated_web_apps:scheme",
       "//content/public/app",
+      "//engine_core",
       "//third_party/cld_3/src/src:cld_3",
     ]

@@ -1371,8 +1372,10 @@

     framework_version = chrome_framework_version
     framework_contents = [
+      "Headers",
       "Helpers",
       "Libraries",
+      "Modules",
       "Resources",
     ]
 

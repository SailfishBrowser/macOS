From: Isaac Lins <104733575+isaaclins@users.noreply.github.com>
Subject: [PATCH] Capture the visible tab without a browser

chrome.tabs.captureVisibleTab looks up the active tab through the
window's browser and its tab list, and reports the tab strip as not
editable without one. EngineCore's windows have no browser, so every
call failed with "Tabs cannot be edited right now", and extensions that
draw on or annotate a page never started. The window controller already
knows its active tab, and CanCaptureVisiblePage still decides access.
---
diff --git a/chrome/browser/extensions/api/tabs/tabs_api.cc b/chrome/browser/extensions/api/tabs/tabs_api.cc
--- a/chrome/browser/extensions/api/tabs/tabs_api.cc
+++ b/chrome/browser/extensions/api/tabs/tabs_api.cc
@@ -3833,23 +3833,26 @@ content::WebContents* TabsCaptureVisibleTabFunction::GetWebContentsForID(
     return nullptr;
   }
 
+  content::WebContents* contents = nullptr;
   BrowserWindowInterface* browser =
       window_controller->GetBrowserWindowInterface();
-  if (!browser) {
-    *error = ExtensionTabUtil::kTabStripNotEditableError;
-    return nullptr;
-  }
-  TabListInterface* tab_list = ExtensionTabUtil::GetEditableTabList(*browser);
-  if (!tab_list) {
-    *error = ExtensionTabUtil::kTabStripNotEditableError;
-    return nullptr;
+  if (browser) {
+    TabListInterface* tab_list = ExtensionTabUtil::GetEditableTabList(*browser);
+    if (!tab_list) {
+      *error = ExtensionTabUtil::kTabStripNotEditableError;
+      return nullptr;
+    }
+    if (::tabs::TabInterface* tab = tab_list->GetActiveTab()) {
+      contents = tab->GetContents();
+    }
+  } else {
+    // EngineCore's windows have no browser, and no tab strip to be busy.
+    contents = window_controller->GetActiveTab();
   }
-  ::tabs::TabInterface* tab = tab_list->GetActiveTab();
-  if (!tab) {
+  if (!contents) {
     *error = "No active web contents to capture";
     return nullptr;
   }
-  content::WebContents* contents = tab->GetContents();
 
   if (!extension()->permissions_data()->CanCaptureVisiblePage(
           contents->GetLastCommittedURL(),
